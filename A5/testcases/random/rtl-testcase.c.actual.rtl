**PROCEDURE: f
**BEGIN: RTL Statements

load:   v0 <- n
load:   t1 <- 0
seq:    t0 <- v0, t1
not:    v0 <- t0
bgtz:   v0, Label1

load:   v0 <- 1
store:  ret <- v0
load:   v0 <- ret
store:  stemp0 <- v0
goto:   Label0
goto:   Label1

Label1:
load:   v0 <- n
load:   t1 <- 1
sub:    t0 <- v0, t1
store:  k <- t0

load:   v0 <- k
push:   v0
v1 = call f_
pop:

move:   v0 <- v1
store:  ret <- v0

load:   v0 <- n
load:   t1 <- ret
mul:    t0 <- v0, t1
store:  ret <- t0

load:   v0 <- ret
store:  stemp0 <- v0
goto:   Label0

Label0:
load:   v1 <- stemp0
return: v1

**END: RTL Statements


**PROCEDURE: main
**BEGIN: RTL Statements

load:   v0 <- 5
store:  b <- v0

load:   v0 <- b
push:   v0
v1 = call f_
pop:

move:   v0 <- v1
store:  a <- v0

load:   v0 <- 1
load:   a0 <- a
write:

load:   v0 <- 2
store:  m <- v0

load:   v0 <- 1
load:   a0 <- m
write:

**END: RTL Statements