**PROCEDURE: func1
**BEGIN: RTL Statements
    iLoad:  v0 <- 5
    store:  i2 <- v0
    iLoad.d: f2 <- 5.0
    store.d: f2 <- f2
**END: RTL Statements

**PROCEDURE: func2
**BEGIN: RTL Statements
    load:   v0 <- a
    iLoad:  t1 <- 10
    add:    t0 <- v0, t1
    store:  a <- t0
    iLoad:  v0 <- 5
    store:  i1 <- v0
    load:   v0 <- a
    load:   t1 <- i1
    add:    t0 <- v0, t1
    load:   t1 <- i2
    add:    v0 <- t0, t1
    iLoad:  t1 <- 2
    add:    t0 <- v0, t1
    store:  stemp0 <- t0
    goto:   Label0

Label0:
    load:   v1 <- stemp0
    return: v1
**END: RTL Statements

**PROCEDURE: func3
**BEGIN: RTL Statements
    load.d: f2 <- b
    load.d: f6 <- f2
    add.d:    f4 <- f2, f6
    store.d: b <- f4
    load.d: f2 <- c
    iLoad.d: f6 <- 10.5
    add.d:    f4 <- f2, f6
    store.d: c <- f4
    load.d: f2 <- b
    load.d: f6 <- c
    add.d:    f4 <- f2, f6
    store.d: stemp0 <- f4
    goto:   Label1

Label1:
    load.d: f0 <- stemp0
    return: f0
**END: RTL Statements

**PROCEDURE: func4
**BEGIN: RTL Statements
    iLoad:  v0 <- 4
    store:  i1 <- v0
    load:   v0 <- i1
    load:   t1 <- i1
    add:    t0 <- v0, t1
    store:  stemp0 <- t0
    goto:   Label2

Label2:
    load:   v1 <- stemp0
    return: v1
**END: RTL Statements

**PROCEDURE: main
**BEGIN: RTL Statements
    call func1_
    v1 = call func4_
    move:   v0 <- v1
    store:  i2 <- v0
    load:   v0 <- i2
    push:   v0
    load.d: f2 <- f2
    push:   f2
    load:   v0 <- i1
    push:   v0
    v1 = call func2_
    pop
    pop
    pop
    move:   v0 <- v1
    store:  i2 <- v0
    load.d: f2 <- f2
    push:   f2
    load.d: f2 <- f1
    push:   f2
    load:   v0 <- i1
    push:   v0
    f0 = call func3_
    pop
    pop
    pop
    move.d: f2 <- f0
    store.d: f2 <- f2
    iLoad:  v0 <- 3
    load.d: f12 <- f1
    write
    iLoad:  v0 <- 3
    load.d: f12 <- f2
    write
**END: RTL Statements
