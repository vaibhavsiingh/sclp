**PROCEDURE: f1
**BEGIN: RTL Statements
    load:   v0 <- b
    load:   t1 <- c
    add:    t0 <- v0, t1
    store:  d <- t0
    load:   v0 <- d
    iLoad:  t1 <- 2
    add:    t0 <- v0, t1
    store:  stemp0 <- t0
    goto:   Label0

Label0:
    load:   v1 <- stemp0
    return: v1
**END: RTL Statements

**PROCEDURE: g
**BEGIN: RTL Statements
    load:   v0 <- b
    store:  stemp0 <- v0
    goto:   Label1

Label1:
    load:   v1 <- stemp0
    return: v1
**END: RTL Statements

**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:  v0 <- 3
    store:  a <- v0
    load:   v0 <- a
    push:   v0
    load:   v0 <- a
    push:   v0
    v1 = call f1_
    pop
    pop
    move:   v0 <- v1
    store:  a <- v0
    iLoad:  v0 <- 1
    load:   a0 <- a
    write
**END: RTL Statements
