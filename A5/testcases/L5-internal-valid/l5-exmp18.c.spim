.data
a: .word 0
b: .word 0
c: .word 0
d: .word 0
x: .word 0
z: .word 0
y: .word 0
_str_0: .asciiz "Hello"
_str_1: .asciiz "hello"

.text
.globl p
p:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    li $v0, 2
    sw $v0, a
    la $v0, _str_0
    sw $v0, 8($fp)
    li $v0, 1
    lw $a0, b
    syscall
    lw $v0, a
    lw $t1, c
    sgt $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label2
    li $v0, 1
    lw $a0, b
    syscall
    j Label1
Label2:
    li $v0, 1
    lw $a0, a
    syscall
Label1:
    lw $v0, 8($fp)
    sw $v0, x
    lw $v0, x
    sw $v0, -4($fp)
    j Label0
Label0:
    lw $v1, -4($fp)
    j epilogue_p

epilogue_p:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl main
main:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 8
    # Prologue ends

    lw $v0, b
    lw $t1, c
    add $t0, $v0, $t1
    sw $t0, a
Label3:
    lw $v0, a
    lw $t1, d
    sgt $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label4
    lw $v0, a
    li $t1, 2
    add $t0, $v0, $t1
    sw $t0, a
    j Label3
Label4:
    la $v0, _str_1
    sw $v0, x
    lw $v0, x
    sw $v0, 0($sp)
    sub $sp, $sp, 4
    jal p
    add $sp, $sp, 4
    move $v0, $v1
    sw $v0, z

epilogue_main:
    add $sp, $sp, 8
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra
