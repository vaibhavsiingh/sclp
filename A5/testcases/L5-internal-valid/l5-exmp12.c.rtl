**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:  v0 <- 5
    store:  a <- v0
    iLoad:  v0 <- 3
    store:  b <- v0
    iLoad:  v0 <- 7
    store:  c <- v0
    iLoad:  v0 <- 2
    store:  d <- v0
    call p_
    load:   v0 <- a
    iLoad:  t1 <- 2
    add:    t0 <- v0, t1
    store:  a <- t0
    load:   v0 <- c
    load:   t1 <- d
    add:    t0 <- v0, t1
    store:  e <- t0
    load:   v0 <- a
    load:   t1 <- b
    mul:    t0 <- v0, t1
    store:  d <- t0
    load:   v0 <- a
    load:   t1 <- c
    add:    t0 <- v0, t1
    load:   t1 <- e
    add:    v0 <- t0, t1
    store:  x <- v0
**END: RTL Statements

**PROCEDURE: p
**BEGIN: RTL Statements
    iLoad:  v0 <- 2
    store:  b <- v0
    load:   v0 <- b
    load:   t1 <- d
    slt:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label1
    load:   v0 <- a
    load:   t1 <- b
    add:    t0 <- v0, t1
    store:  c <- t0
    goto:   Label0

Label1:

Label0:
    load:   v0 <- c
    load:   t1 <- d
    add:    t0 <- v0, t1
    store:  x <- t0
**END: RTL Statements

**PROCEDURE: q
**BEGIN: RTL Statements
    iLoad:  v0 <- 1
    store:  a <- v0
    load:   v0 <- a
    load:   t1 <- b
    mul:    t0 <- v0, t1
    store:  a <- t0
**END: RTL Statements
