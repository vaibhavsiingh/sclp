.data
a: .word 0
b: .word 0
c: .word 0
d: .word 0
e: .word 0
x: .word 0

.text
.globl main
main:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    li $v0, 5
    sw $v0, a
    li $v0, 3
    sw $v0, b
    li $v0, 7
    sw $v0, c
    li $v0, 2
    sw $v0, d
    jal p
    lw $v0, a
    li $t1, 2
    add $t0, $v0, $t1
    sw $t0, a
    lw $v0, c
    lw $t1, d
    add $t0, $v0, $t1
    sw $t0, e
    lw $v0, a
    lw $t1, b
    mul $t0, $v0, $t1
    sw $t0, d
    lw $v0, a
    lw $t1, c
    add $t0, $v0, $t1
    lw $t1, e
    add $v0, $t0, $t1
    sw $v0, -4($fp)

epilogue_main:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl p
p:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    li $v0, 2
    sw $v0, b
    lw $v0, b
    lw $t1, d
    slt $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label0
    lw $v0, a
    lw $t1, b
    add $t0, $v0, $t1
    sw $t0, c
    j Label0
Label0:
    lw $v0, c
    lw $t1, d
    add $t0, $v0, $t1
    sw $t0, -4($fp)

epilogue_p:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl q
q:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 8
    # Prologue ends

    li $v0, 1
    sw $v0, a
    lw $v0, a
    lw $t1, b
    mul $t0, $v0, $t1
    sw $t0, a

epilogue_q:
    add $sp, $sp, 8
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra
