.data
a: .word 0
b: .float 0.0
c: .float 0.0
fl1: .float 0.0
fl2: .float 0.0
l1: .word 0
l2: .word 0

.text
.globl func1
func1:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 8
    # Prologue ends

    li $v0, 5
    sw $v0, l2
    li.d $f2, 5.0
    s.d $f2, fl2

epilogue_func1:
    add $sp, $sp, 8
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl func2
func2:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    lw $v0, a
    li $t1, 10
    add $t0, $v0, $t1
    sw $t0, a
    li $v0, 5
    sw $v0, l1
    lw $v0, a
    lw $t1, l1
    add $t0, $v0, $t1
    lw $t1, l2
    add $v0, $t0, $t1
    li $t1, 2
    add $t0, $v0, $t1
    sw $t0, stemp0
    j Label0
Label0:
    lw $v1, stemp0
    j epilogue_func2

epilogue_func2:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl func3
func3:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    l.d $f2, b
    l.d $f6, fl2
    mul.d $f4, $f2, $f6
    s.d $f4, b
    l.d $f2, c
    li.d $f6, 10.5
    add.d $f4, $f2, $f6
    s.d $f4, c
    l.d $f2, b
    l.d $f6, c
    add.d $f4, $f2, $f6
    s.d $f4, stemp0
    j Label1
Label1:
    l.d $f0, stemp0
    j epilogue_func3

epilogue_func3:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl func4
func4:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    li $v0, 4
    sw $v0, l1
    lw $v0, l1
    lw $t1, l1
    add $t0, $v0, $t1
    sw $t0, stemp0
    j Label2
Label2:
    lw $v1, stemp0
    j epilogue_func4

epilogue_func4:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra

.text
.globl main
main:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 8
    # Prologue ends

    jal func1
    jal func4
    move $v0, $v1
    sw $v0, l2
    lw $v0, l2
    sub $sp, $sp, 4
    sw $v0, 0($sp)
    l.d $f2, fl2
    sub $sp, $sp, 4
    sw $f2, 0($sp)
    lw $v0, l1
    sub $sp, $sp, 4
    sw $v0, 0($sp)
    jal func2
    add $sp, $sp, 4
    add $sp, $sp, 4
    add $sp, $sp, 4
    move $v0, $v1
    sw $v0, l2
    l.d $f2, fl2
    sub $sp, $sp, 4
    sw $f2, 0($sp)
    l.d $f2, fl2
    sub $sp, $sp, 4
    sw $f2, 0($sp)
    lw $v0, l1
    sub $sp, $sp, 4
    sw $v0, 0($sp)
    jal func3
    add $sp, $sp, 4
    add $sp, $sp, 4
    add $sp, $sp, 4
    mov.d $f2, $f0
    s.d $f2, fl2
    li $v0, 3
    l.d $f12, fl1
    syscall
    li $v0, 3
    l.d $f12, fl2
    syscall

epilogue_main:
    add $sp, $sp, 8
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra
