*PROCEDURE: main
**BEGIN: RTL Statements

    iLoad:  v0 <- 5
    store:  a <- v0
    iLoad:  v0 <- 0
    store:  i <- v0
Label0:
    load:   v0 <- i
    load:   t1 <- a
    slt:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label1
    load:   v0 <- i
    iLoad:  t1 <- 1
    add:    t0 <- v0, t1
    store:  i <- t0
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- i
    write
    goto:   Label0
Label1:

**END: RTL Statements
