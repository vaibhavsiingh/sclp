**PROCEDURE: main
**BEGIN: RTL Statements

    ILoad:  v0 <- 0
    store:  test <- v0
    ILoad:  v0 <- 10
    store:  loop <- v0
Label2:
    load:   v0 <- loop
    ILoad:  t1 <- 1
    sgt:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label3
    load:   v0 <- loop
    ILoad:  t1 <- 1
    sub:    t0 <- v0, t1
    store:  loop <- t0
    load:   v0 <- loop
    ILoad:  t1 <- 0
    seq:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label1
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- loop
    write
    goto:   Label0
Label1:
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- test
    write
Label0:
    goto:   Label2
Label3:
Label4:
    load:   v0 <- loop
    ILoad:  t1 <- 1
    add:    t0 <- v0, t1
    store:  loop <- t0
    load:   v0 <- loop
    ILoad:  t1 <- 10
    slt:    t0 <- v0, t1
    bgtz:   t0, Label4
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- loop
    write


**END: RTL Statements
