**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:  v0 <- 4
    load_addr: a0 <- _str_0
    write
    iLoad:  v0 <- 6
    read
    store.d: marks <- f0
    load.d: f2 <- marks
    iLoad.d: f4 <- 40.0
    slt.d:    f2, f4
    iLoad:  v0 <- 1
    move:   t0 <- zero
    movt:    t0 <- v0, 0
    not:    v0 <- t0
    bgtz:   v0, Label0
    load_addr: v0 <- _str_1
    store:  stemp0 <- v0
    goto:   Label1

Label0:
    load.d: f2 <- marks
    iLoad:  f4 <- 40
    slt.d:    f2, f4
    iLoad:  v0 <- 1
    move:   t0 <- zero
    movf:    t0 <- v0, 0
    not:    v0 <- t0
    bgtz:   v0, Label2
    load_addr: v0 <- _str_2
    store:  stemp1 <- v0
    goto:   Label3

Label2:
    load_addr: v0 <- _str_3
    store:  stemp1 <- v0

Label3:
    load:   v0 <- stemp1
    store:  stemp0 <- v0

Label1:
    load:   v0 <- stemp0
    store:  grade <- v0
    iLoad:  v0 <- 4
    load_addr: a0 <- _str_4
    write
    iLoad:  v0 <- 1
    load:   a0 <- grade
    write
**END: RTL Statements
