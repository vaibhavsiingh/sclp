.data

.text
.globl main
main:
    # Prologue begins
    sw $ra, 0($sp)
    sw $fp, -4($sp)
    sub $fp, $sp, 4
    sub $sp, $sp, 12
    # Prologue ends

    li.d $f2, 2.0
    s.d $f2, -4($fp)1
    l.d $f2, -4($fp)
    li.d $f6, 2.0
    mul.d $f4, $f2, $f6
    li.d $f6, 3.0
    add.d $f2, $f4, $f6
    s.d $f2, -4($fp)1
    l.d $f2, -4($fp)
    li.d $f6, 2.0
    mul.d $f4, $f2, $f6
    s.d $f4, -4($fp)1

epilogue_main:
    add $sp, $sp, 12
    lw $fp, -4($sp)
    lw $ra, 0($sp)
    jr $ra
