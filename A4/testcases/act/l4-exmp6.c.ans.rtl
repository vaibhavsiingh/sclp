**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:    v0 <- 5
    store:    a <- v0
    iLoad:    v0 <- 1
    store:    b <- v0
    iLoad:    v0 <- 3
    iLoad:    t1 <- 2
    sgt:      t0 <- v0, t1
    not:      v0 <- t0
    bgtz:     v0, Label0
    load:     v0 <- a
    store:    stemp0 <- v0
    goto:     Label1

Label0:
    iLoad:    v0 <- 4
    store:    stemp0 <- v0

Label1:
    load:     v0 <- stemp0
    iLoad:    t1 <- 5
    sgt:      t0 <- v0, t1
    not:      v0 <- t0
    bgtz:     v0, Label3
    iLoad:    v0 <- 10
    store:    c_ <- v0
    goto:     Label2

Label3:
    load:     v0 <- a
    iLoad:    t1 <- 5
    seq:      t0 <- v0, t1
    not:      v0 <- t0
    bgtz:     v0, Label4
    iLoad:    v0 <- 2
    store:    c_ <- v0
    goto:     Label4

Label4:

Label2:
**END: RTL Statements