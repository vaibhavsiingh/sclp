**PROCEDURE: main
**BEGIN: RTL Statements

    iLoad:  v0 <- 5        ;; syscall: read integer
    read
    store:  n <- v0
    load:   v0 <- n
    ILoad:  t1 <- 5
    sge:    t0 <- v0, t1
    load:   v0 <- n
    ILoad:  t2 <- 10
    sle:    t1 <- v0, t2
    and:    v0 <- t0, t1
    not:    t0 <- v0
    bgtz:   t0, Label3
Label0:
    load:   v0 <- n
    ILoad:  t1 <- 0
    sgt:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label1
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- n
    write
    iLoad:  v0 <- 4        ;; syscall: print string
    load_addr: a0 <- _str_0
    write
    load:   v0 <- n
    ILoad:  t1 <- 1
    sub:    t0 <- v0, t1
    store:  n <- t0
    goto:   Label0
Label1:
    goto:   Label2
Label3:
    load:   v0 <- n
    ILoad:  t1 <- 1024
    sle:    t0 <- v0, t1
    ILoad:  v0 <- 1024
    uminus: t1 <- v0
    load:   v0 <- n
    sge:    t2 <- v0, t1
    and:    v0 <- t0, t2
    not:    t0 <- v0
    bgtz:   t0, Label6
Label4:
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- n
    write
    iLoad:  v0 <- 4        ;; syscall: print string
    load_addr: a0 <- _str_0
    write
    load:   v0 <- n
    ILoad:  t1 <- 2
    div:    t0 <- v0, t1
    store:  n <- t0
    load:   v0 <- n
    ILoad:  t1 <- 0
    sne:    t0 <- v0, t1
    bgtz:   t0, Label4
    goto:   Label5
Label6:
    iLoad:  v0 <- 4        ;; syscall: print string
    load_addr: a0 <- _str_1
    write
    iLoad:  v0 <- 1        ;; syscall: print integer
    load:   a0 <- n
    write
Label5:
Label2:


**END: RTL Statements
