**PROCEDURE: main
**BEGIN: RTL Statements
    ILoad.d: f2 <- 2.3
    store.d: a <- f2
    ILoad.d: f2 <- 3.4
    store.d: b <- f2
    ILoad.d: f2 <- 4.5
    store.d: c <- f2
    ILoad.d: f2 <- 5.6
    store.d: d <- f2
    ILoad.d: f2 <- 6.7
    store.d: e <- f2
    load.d: f2 <- b
    load.d: f6 <- c
    add.d:    f4 <- f2, f6
    load.d: f2 <- a
    slt.d:    f2, f4
    iLoad:  v0 <- 1
    move:   t0 <- zero
    movf:    t0 <- v0, 0
    load.d: f2 <- e
    load.d: f6 <- d
    mul.d:    f4 <- f2, f6
    load.d: f6 <- c
    div.d:    f2 <- f4, f6
    load.d: f4 <- d
    sle.d:    f4, f2
    iLoad:  v0 <- 1
    move:   t1 <- zero
    movf:    t1 <- v0, 0
    and:    t2 <- t0, t1
    not:    t0 <- t2
    bgtz:   t0, Label1
    load.d: f2 <- a
    load.d: f6 <- d
    mul.d:    f4 <- f2, f6
    load.d: f6 <- e
    div.d:    f2 <- f4, f6
    store.d: a <- f2
    goto:   Label0
Label1:
    load.d: f2 <- e
    load.d: f6 <- d
    add.d:    f4 <- f2, f6
    store.d: e <- f4
Label0:


**END: RTL Statements
