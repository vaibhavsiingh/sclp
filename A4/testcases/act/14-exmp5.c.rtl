**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:  v0 <- 5
    read
    store:  local <- v0
    load:   v0 <- local
    store:  global2 <- v0
    iLoad:  v0 <- 5
    store:  global1 <- v0
    load:   v0 <- global2
    load:   t1 <- global1
    sgt:    t0 <- v0, t1
    load:   v0 <- local
    iLoad:  t2 <- 2
    sub:    t1 <- v0, t2
    iLoad:  t2 <- 0
    sne:    v0 <- t1, t2
    and:    t1 <- t0, v0
    not:    v0 <- t1
    bgtz:   v0, Label0
    iLoad:  v0 <- 1
    store:  stemp0 <- v0
    goto:   Label1

Label0:
    iLoad:  v0 <- 0
    store:  stemp0 <- v0

Label1:
    load:   v0 <- stemp0
    store:  ans <- v0
    load:   v0 <- ans
    iLoad:  t1 <- 1
    seq:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label5

Label2:
    load:   v0 <- global2
    iLoad:  t1 <- 0
    sgt:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label3
    iLoad:  v0 <- 1
    load:   a0 <- global2
    write
    load:   v0 <- global2
    iLoad:  t1 <- 1
    sub:    t0 <- v0, t1
    store:  global2 <- t0
    goto:   Label2

Label3:
    goto:   Label4

Label5:

Label6:
    iLoad:  v0 <- 1
    load:   a0 <- global2
    write
    load:   v0 <- global2
    iLoad:  t1 <- 1
    add:    t0 <- v0, t1
    store:  global2 <- t0
    load:   v0 <- global2
    iLoad:  t1 <- 10
    slt:    t0 <- v0, t1
    bgtz:   t0, Label6

Label4:
**END: RTL Statements
