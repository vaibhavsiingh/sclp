*PROCEDURE: main
**BEGIN: RTL Statements

    iLoad:  v0 <- 14
    store:  x <- v0
    iLoad:  v0 <- 36
    store:  y <- v0
    load:   v0 <- x
    store:  a <- v0
    load:   v0 <- y
    store:  b <- v0
Label0:
    load:   v0 <- b
    iLoad:  t1 <- 0
    sne:    t0 <- v0, t1
    not:    v0 <- t0
    bgtz:   v0, Label1
    load:   v0 <- b
    store:  t <- v0
    load:   v0 <- a
    load:   t1 <- b
    div:    t0 <- v0, t1
    load:   t2 <- b
    mul:    t1 <- t0, t2
    store:  b <- t1
    load:   v0 <- t
    store:  a <- v0
    goto:   Label0
Label1:
    load:   v0 <- a
    store:  gcd <- v0
    load:   v0 <- x
    load:   t1 <- y
    mul:    t0 <- v0, t1
    load:   t2 <- gcd
    div:    t1 <- t0, t2
    store:  lcm <- t1

**END: RTL Statements
